+# Copyright (c) 2026, RTE (http://www.rte-france.com)
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+# SPDX-License-Identifier: MPL-2.0
+#
+"""Public entry point of the continuation power flow analysis."""
+from typing import Optional
+
+from pypowsybl import _pypowsybl
+from pypowsybl.network import Network
+from .parameters import ContinuationParameters
+from .continuation_result import ContinuationResult
+
+
+def run(network: Network, parameters: Optional[ContinuationParameters] = None) -> ContinuationResult:
+    """
+    Runs a continuation power flow to estimate the voltage collapse / maximum loadability point of a network.
+
+    Args:
+        network: the network, on its working variant.
+        parameters: the continuation parameters (engine, load/generation directions, stepping). Defaults apply
+            if omitted.
+
+    Returns:
+        a :class:`ContinuationResult` exposing the traced P-V curve, the reactive-limit breakpoints and a
+        collapse summary (loadability margin, critical bus).
+
+    Example:
+        .. code-block:: python
+
+            import pypowsybl.network as pn
+            import pypowsybl.continuation as continuation
+
+            network = pn.create_eurostag_tutorial_example1_network()
+            result = continuation.run(network)
+            print(result.status, result.max_load_factor, result.critical_bus_id)
+            result.pv_curve(result.critical_bus_id)  # a plottable DataFrame
+    """
+    p = parameters if parameters is not None else ContinuationParameters()
+    handle = _pypowsybl.run_continuation_power_flow(
+        network._handle,  # pylint: disable=protected-access
+        p.engine.value,
+        p.initial_step_size,
+        p.min_step_size,
+        p.max_steps,
+        p.enforce_reactive_limits,
+        p.scale_reactive_power_with_active_power,
+        ','.join(p.load_ids) if p.load_ids else '',
+        ','.join(p.generator_ids) if p.generator_ids else '',
+    )
+    return ContinuationResult(handle)
diff --git a/pypowsybl/continuation/impl/continuation_result.py b/pypowsybl/continuation/impl/continuation_result.py
new file mode 100644
index 0000000..4a96997
--- /dev/null
+++ b/pypowsybl/continuation/impl/continuation_result.py
@@ -0,0 +1,91 @@
+# Copyright (c) 2026, RTE (http://www.rte-france.com)
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+# SPDX-License-Identifier: MPL-2.0
+#
+"""Result of a continuation power flow: the traced P-V curve and the collapse point."""
+from typing import List
+
+import numpy as np
+from pandas import DataFrame
+
+from pypowsybl import _pypowsybl
+from pypowsybl.utils import create_data_frame_from_series_array
+
+
+def _series_array_to_frame(series_array: _pypowsybl.SeriesArray) -> DataFrame:
+    """Build a DataFrame from an index-less series array (e.g. the one-row summary)."""
+    data = {}
+    for series in series_array:
+        if series.mask.any():
+            data[series.name] = np.ma.masked_array(series.data, series.mask)
+        else:
+            data[series.name] = series.data
+    return DataFrame(data)
+
+
+class ContinuationResult:
+    """
+    Wraps the native continuation result handle and exposes the traced curve and the collapse summary as
+    pandas DataFrames. Instances are returned by :func:`pypowsybl.continuation.run`.
+    """
+
+    def __init__(self, handle: _pypowsybl.JavaHandle):
+        self._handle = handle
+        self._curve = create_data_frame_from_series_array(_pypowsybl.get_continuation_curve(handle))
+        self._breakpoints = create_data_frame_from_series_array(_pypowsybl.get_continuation_breakpoints(handle))
+        self._summary = _series_array_to_frame(_pypowsybl.get_continuation_summary(handle))
+
+    @property
+    def curve(self) -> DataFrame:
+        """The P-V curve, indexed by ``(point, bus_id)`` with columns ``load_factor``, ``voltage``,
+        ``dv_dlambda`` and ``stable``."""
+        return self._curve
+
+    @property
+    def breakpoints(self) -> DataFrame:
+        """The reactive-limit breakpoints (empty unless ``enforce_reactive_limits`` was set)."""
+        return self._breakpoints
+
+    @property
+    def summary(self) -> DataFrame:
+        """One-row summary: ``status``, ``max_load_factor``, ``critical_bus_id``, ``nose_min_voltage``,
+        ``point_count``."""
+        return self._summary
+
+    @property
+    def status(self) -> str:
+        """The continuation status (e.g. ``NOSE_POINT_REACHED``)."""
+        return str(self._summary['status'].iloc[0])
+
+    @property
+    def max_load_factor(self) -> float:
+        """The loadability margin: lambda at the nose (voltage collapse point)."""
+        return float(self._summary['max_load_factor'].iloc[0])
+
+    @property
+    def critical_bus_id(self) -> str:
+        """The id of the bus driving the collapse."""
+        return str(self._summary['critical_bus_id'].iloc[0])
+
+    def pv_curve(self, bus_id: str) -> DataFrame:
+        """The P-V curve of a single bus, in traced order (upper branch then lower branch)."""
+        return self._curve[self._curve.index.get_level_values('bus_id') == bus_id]
+
+    @property
+    def monitored_bus_ids(self) -> List[str]:
+        """The buses whose voltage was recorded along the curve."""
+        return list(dict.fromkeys(self._curve.index.get_level_values('bus_id')))
+
+    def close(self) -> None:
+        """Release the native result. Called automatically on garbage collection."""
+        if getattr(self, '_handle', None) is not None:
+            _pypowsybl.free_continuation_result(self._handle)
+            self._handle = None
+
+    def __del__(self) -> None:
+        try:
+            self.close()
+        except Exception:  # pylint: disable=broad-except
+            pass
