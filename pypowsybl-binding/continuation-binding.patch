+package com.powsybl.python.continuation;
+
+import com.powsybl.iidm.network.Network;
+import com.powsybl.openloadflow.ac.continuation.ContinuationAnalysis;
+import com.powsybl.openloadflow.ac.continuation.ContinuationAnalysisParameters;
+import com.powsybl.openloadflow.ac.continuation.ContinuationResult;
+import com.powsybl.openloadflow.ac.continuation.GenerationParticipation;
+import com.powsybl.openloadflow.ac.continuation.LoadIncreaseDirection;
+import com.powsybl.python.commons.CTypeUtil;
+import com.powsybl.python.commons.Directives;
+import com.powsybl.python.commons.PyPowsyblApiHeader;
+import com.powsybl.python.commons.PyPowsyblApiHeader.ArrayPointer;
+import com.powsybl.python.commons.PyPowsyblApiHeader.SeriesPointer;
+import com.powsybl.python.commons.Util.PointerProvider;
+import com.powsybl.python.network.Dataframes;
+import org.graalvm.nativeimage.IsolateThread;
+import org.graalvm.nativeimage.ObjectHandle;
+import org.graalvm.nativeimage.ObjectHandles;
+import org.graalvm.nativeimage.c.CContext;
+import org.graalvm.nativeimage.c.function.CEntryPoint;
+import org.graalvm.nativeimage.c.type.CCharPointer;
+
+import java.util.Arrays;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import static com.powsybl.python.commons.Util.doCatch;
+
+/**
+ * C entry points for the continuation power flow (voltage collapse) analysis.
+ *
+ * <p>PROTOTYPE (Phase 1). This is the first pypowsybl C-API that depends directly on an OpenLoadFlow class
+ * ({@link ContinuationAnalysis}) rather than on a powsybl-core provider SPI, because the continuation analysis
+ * is OpenLoadFlow-specific. It builds against an OpenLoadFlow that contains
+ * {@code com.powsybl.openloadflow.ac.continuation} (currently 2.3.0-SNAPSHOT; override the
+ * {@code powsybl-open-loadflow} version in {@code java/pypowsybl/pom.xml} until it is released).</p>
+ *
+ * <p>The run entry point returns an {@link ObjectHandle} to the {@link ContinuationResult}; the traced curve,
+ * the reactive-limit breakpoints and the scalar summary are then read back as dataframes (series arrays), the
+ * same way security analysis exposes its several result tables.</p>
+ *
+ * @author Claude
+ */
+@SuppressWarnings({"java:S1602", "java:S1604", "Convert2Lambda"})
+@CContext(Directives.class)
+public final class ContinuationCFunctions {
+
+    private ContinuationCFunctions() {
+    }
+
+    @CEntryPoint(name = "runContinuationPowerFlow")
+    public static ObjectHandle runContinuationPowerFlow(IsolateThread thread, ObjectHandle networkHandle,
+                                                        int engine, double initialStepSize, double minStepSize, int maxSteps,
+                                                        boolean enforceReactiveLimits, boolean scaleReactivePowerWithActivePower,
+                                                        CCharPointer loadIdsPtr, CCharPointer generatorIdsPtr,
+                                                        PyPowsyblApiHeader.ExceptionHandlerPointer exceptionHandlerPtr) {
+        return doCatch(exceptionHandlerPtr, new PointerProvider<>() {
+            @Override
+            public ObjectHandle get() {
+                Network network = ObjectHandles.getGlobal().get(networkHandle);
+                String loadIds = CTypeUtil.toString(loadIdsPtr);       // empty -> all loads
+                String generatorIds = CTypeUtil.toString(generatorIdsPtr); // empty -> none (slack absorbs)
+
+                ContinuationAnalysisParameters parameters = new ContinuationAnalysisParameters()
+                        .setEngine(engine == 0 ? ContinuationAnalysisParameters.Engine.STEPPED
+                                               : ContinuationAnalysisParameters.Engine.PREDICTOR_CORRECTOR)
+                        .setLoadIncreaseDirection(loadIds.isEmpty()
+                                ? LoadIncreaseDirection.allLoads()
+                                : LoadIncreaseDirection.ofLoadIds(splitToSet(loadIds)))
+                        .setGenerationParticipation(generatorIds.isEmpty()
+                                ? GenerationParticipation.none()
+                                : GenerationParticipation.ofGeneratorIds(splitToSet(generatorIds)));
+
+                parameters.getPredictorCorrectorParameters()
+                        .setInitialStepSize(initialStepSize)
+                        .setMinStepSize(minStepSize)
+                        .setMaxSteps(maxSteps)
+                        .setEnforceReactiveLimits(enforceReactiveLimits)
+                        .setScaleReactivePowerWithActivePower(scaleReactivePowerWithActivePower);
+                parameters.getSteppedParameters()
+                        .setInitialStepSize(initialStepSize)
+                        .setMinStepSize(minStepSize)
+                        .setMaxSteps(maxSteps)
+                        .setScaleReactivePowerWithActivePower(scaleReactivePowerWithActivePower);
+
+                ContinuationResult result = ContinuationAnalysis.run(network, parameters);
+                return ObjectHandles.getGlobal().create(result);
+            }
+        });
+    }
+
+    @CEntryPoint(name = "getContinuationCurve")
+    public static ArrayPointer<SeriesPointer> getContinuationCurve(IsolateThread thread, ObjectHandle resultHandle,
+                                                                   PyPowsyblApiHeader.ExceptionHandlerPointer exceptionHandlerPtr) {
+        return doCatch(exceptionHandlerPtr, new PointerProvider<>() {
+            @Override
+            public ArrayPointer<SeriesPointer> get() {
+                ContinuationResult result = ObjectHandles.getGlobal().get(resultHandle);
+                return Dataframes.createCDataframe(ContinuationDataframes.curveMapper(), result);
+            }
+        });
+    }
+
+    @CEntryPoint(name = "getContinuationBreakpoints")
+    public static ArrayPointer<SeriesPointer> getContinuationBreakpoints(IsolateThread thread, ObjectHandle resultHandle,
+                                                                         PyPowsyblApiHeader.ExceptionHandlerPointer exceptionHandlerPtr) {
+        return doCatch(exceptionHandlerPtr, new PointerProvider<>() {
+            @Override
+            public ArrayPointer<SeriesPointer> get() {
+                ContinuationResult result = ObjectHandles.getGlobal().get(resultHandle);
+                return Dataframes.createCDataframe(ContinuationDataframes.breakpointsMapper(), result);
+            }
+        });
+    }
+
+    @CEntryPoint(name = "getContinuationSummary")
+    public static ArrayPointer<SeriesPointer> getContinuationSummary(IsolateThread thread, ObjectHandle resultHandle,
+                                                                     PyPowsyblApiHeader.ExceptionHandlerPointer exceptionHandlerPtr) {
+        return doCatch(exceptionHandlerPtr, new PointerProvider<>() {
+            @Override
+            public ArrayPointer<SeriesPointer> get() {
+                ContinuationResult result = ObjectHandles.getGlobal().get(resultHandle);
+                return Dataframes.createCDataframe(ContinuationDataframes.summaryMapper(), result);
+            }
+        });
+    }
+
+    @CEntryPoint(name = "freeContinuationResult")
+    public static void freeContinuationResult(IsolateThread thread, ObjectHandle resultHandle,
+                                              PyPowsyblApiHeader.ExceptionHandlerPointer exceptionHandlerPtr) {
+        doCatch(exceptionHandlerPtr, new Runnable() {
+            @Override
+            public void run() {
+                ObjectHandles.getGlobal().destroy(resultHandle);
+            }
+        });
+    }
+
+    private static Set<String> splitToSet(String csv) {
+        return Arrays.stream(csv.split(","))
+                .map(String::trim)
+                .filter(s -> !s.isEmpty())
+                .collect(Collectors.toSet());
+    }
+}
diff --git a/java/pypowsybl/src/main/java/com/powsybl/python/continuation/ContinuationDataframes.java b/java/pypowsybl/src/main/java/com/powsybl/python/continuation/ContinuationDataframes.java
