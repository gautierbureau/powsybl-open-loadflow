@@ -0,0 +1,56 @@
+# Copyright (c) 2026, RTE (http://www.rte-france.com)
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+# SPDX-License-Identifier: MPL-2.0
+#
+"""Spec for the continuation power flow binding (requires the native module built against
+open-loadflow >= 2.3.0-SNAPSHOT with the continuation package)."""
+import pytest
+
+import pypowsybl.network as pn
+import pypowsybl.continuation as continuation
+from pypowsybl.continuation import ContinuationParameters, ContinuationEngine
+
+
+def test_predictor_corrector_traces_nose():
+    network = pn.create_eurostag_tutorial_example1_network()
+    result = continuation.run(network, ContinuationParameters(engine=ContinuationEngine.PREDICTOR_CORRECTOR))
+
+    assert result.status == 'NOSE_POINT_REACHED'
+    assert result.max_load_factor > 0.5
+
+    curve = result.curve
+    assert not curve.empty
+    assert {'load_factor', 'voltage', 'dv_dlambda', 'stable'}.issubset(curve.columns)
+    # the predictor-corrector traces the unstable lower branch
+    assert (~curve['stable']).any()
+
+
+def test_per_bus_curve_and_summary():
+    network = pn.create_eurostag_tutorial_example1_network()
+    result = continuation.run(network)
+
+    assert result.monitored_bus_ids
+    pv = result.pv_curve(result.critical_bus_id)
+    assert not pv.empty
+    # voltage decreases along the traced curve
+    assert pv['voltage'].iloc[-1] < pv['voltage'].iloc[0]
+
+    summary = result.summary
+    assert summary.loc[0, 'point_count'] == len(curve_points(result))
+
+
+def curve_points(result):
+    return result.curve.index.get_level_values('point').unique()
+
+
+def test_stepped_engine_stays_on_stable_branch():
+    network = pn.create_eurostag_tutorial_example1_network()
+    result = continuation.run(network, ContinuationParameters(engine=ContinuationEngine.STEPPED))
+    assert result.status == 'NOSE_POINT_REACHED'
+    assert result.curve['stable'].all()
+
+
+if __name__ == '__main__':
+    pytest.main([__file__])
