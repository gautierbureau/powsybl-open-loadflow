+# Copyright (c) 2026, RTE (http://www.rte-france.com)
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+# SPDX-License-Identifier: MPL-2.0
+#
+"""Parameters of a continuation power flow (voltage collapse) analysis."""
+from dataclasses import dataclass
+from enum import Enum
+from typing import List, Optional
+
+
+class ContinuationEngine(Enum):
+    """Which continuation engine to run."""
+    STEPPED = 0
+    """Reuses the full AC engine and its outer loops. Traces the stable branch and the margin; stops at the nose."""
+    PREDICTOR_CORRECTOR = 1
+    """True CPF: passes through the nose and traces the unstable branch, on a smooth single-slack model."""
+
+
+@dataclass
+class ContinuationParameters:
+    """
+    Parameters of :func:`pypowsybl.continuation.run`.
+
+    Args:
+        engine: the continuation engine (default: predictor-corrector).
+        initial_step_size: first load-factor / arc-length step.
+        min_step_size: continuation stops when the adaptive step falls below this.
+        max_steps: safety bound on the number of steps.
+        enforce_reactive_limits: predictor-corrector only — switch PV buses to PQ at their reactive limit,
+            introducing breakpoints on the curve.
+        scale_reactive_power_with_active_power: keep a constant power factor when scaling loads.
+        load_ids: ids of the loads that increase; ``None`` means all loads.
+        generator_ids: ids of the generators that ramp up to pick up the load; ``None`` means none
+            (the slack bus absorbs the increase). Predictor-corrector only.
+    """
+    engine: ContinuationEngine = ContinuationEngine.PREDICTOR_CORRECTOR
+    initial_step_size: float = 0.1
+    min_step_size: float = 1e-3
+    max_steps: int = 400
+    enforce_reactive_limits: bool = False
+    scale_reactive_power_with_active_power: bool = True
+    load_ids: Optional[List[str]] = None
+    generator_ids: Optional[List[str]] = None
diff --git a/tests/test_continuation.py b/tests/test_continuation.py
