@@ -0,0 +1,88 @@
+/**
+ * Copyright (c) 2026, RTE (http://www.rte-france.com)
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ * SPDX-License-Identifier: MPL-2.0
+ */
+package com.powsybl.python.continuation;
+
+import com.powsybl.dataframe.DataframeMapper;
+import com.powsybl.dataframe.DataframeMapperBuilder;
+import com.powsybl.openloadflow.ac.continuation.ContinuationPoint;
+import com.powsybl.openloadflow.ac.continuation.ContinuationResult;
+import com.powsybl.openloadflow.ac.continuation.PvCurvePoint;
+import com.powsybl.openloadflow.ac.continuation.ReactiveLimitBreakpoint;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Dataframe mappers turning a {@link ContinuationResult} into the series arrays (dataframes) returned to Python:
+ * the P-V curve (one row per bus per continuation point), the reactive-limit breakpoints, and a one-row scalar
+ * summary.
+ *
+ * @author Claude
+ */
+public final class ContinuationDataframes {
+
+    private ContinuationDataframes() {
+    }
+
+    /** One flattened row of the P-V curve: a bus voltage at a continuation point. */
+    private record CurveRow(int point, String busId, double loadFactor, double voltage, double dvDlambda, boolean stable) {
+    }
+
+    private static List<CurveRow> curveRows(ContinuationResult result) {
+        List<CurveRow> rows = new ArrayList<>();
+        List<ContinuationPoint> points = result.getPoints();
+        for (String busId : result.getMonitoredBusIds()) {
+            List<PvCurvePoint> curve = result.getPvCurve(busId);
+            for (int i = 0; i < curve.size(); i++) {
+                PvCurvePoint p = curve.get(i);
+                rows.add(new CurveRow(i, busId, p.loadFactor(), p.voltage(), p.dvDlambda(), p.stable()));
+            }
+        }
+        // fall back to the weakest-bus curve when per-bus voltages were not recorded
+        if (rows.isEmpty()) {
+            for (int i = 0; i < points.size(); i++) {
+                ContinuationPoint p = points.get(i);
+                rows.add(new CurveRow(i, p.minVoltageBusId(), p.loadFactor(), p.minVoltage(), Double.NaN, p.stable()));
+            }
+        }
+        return rows;
+    }
+
+    public static DataframeMapper<ContinuationResult, Void> curveMapper() {
+        return new DataframeMapperBuilder<ContinuationResult, CurveRow, Void>()
+                .itemsProvider(ContinuationDataframes::curveRows)
+                .intsIndex("point", CurveRow::point)
+                .stringsIndex("bus_id", CurveRow::busId)
+                .doubles("load_factor", CurveRow::loadFactor)
+                .doubles("voltage", CurveRow::voltage)
+                .doubles("dv_dlambda", CurveRow::dvDlambda)
+                .booleans("stable", CurveRow::stable)
+                .build();
+    }
+
+    public static DataframeMapper<ContinuationResult, Void> breakpointsMapper() {
+        return new DataframeMapperBuilder<ContinuationResult, ReactiveLimitBreakpoint, Void>()
+                .itemsProvider(ContinuationResult::getReactiveLimitBreakpoints)
+                .stringsIndex("bus_id", ReactiveLimitBreakpoint::busId)
+                .doubles("load_factor", ReactiveLimitBreakpoint::loadFactor)
+                .doubles("q_limit_mvar", ReactiveLimitBreakpoint::qLimitMvar)
+                .booleans("max_limit", ReactiveLimitBreakpoint::maxLimit)
+                .build();
+    }
+
+    public static DataframeMapper<ContinuationResult, Void> summaryMapper() {
+        return new DataframeMapperBuilder<ContinuationResult, ContinuationResult, Void>()
+                .itemsProvider(result -> List.of(result))
+                .enums("status", ContinuationResult.Status.class, ContinuationResult::getStatus)
+                .doubles("max_load_factor", ContinuationResult::getMaxLoadFactor)
+                .strings("critical_bus_id", r -> r.getCriticalBusId().orElse(""))
+                .doubles("nose_min_voltage", r -> r.getNosePoint().map(ContinuationPoint::minVoltage).orElse(Double.NaN))
+                .ints("point_count", r -> r.getPoints().size())
+                .build();
+    }
+}
