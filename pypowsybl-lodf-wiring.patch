+def test_lodf_matrix():
+    network = pp.network.create_eurostag_tutorial_example1_network()
+    branch_ids = ['NHV1_NHV2_1', 'NHV1_NHV2_2', 'NGEN_NHV1']
+    lodf = pp.sensitivity.compute_lodf_matrix(network, branch_ids, branch_ids)
+    assert lodf.shape == (3, 3)
+    # the outage of one of the two identical parallel lines transfers all of its flow to the other one
+    assert lodf.loc['NHV1_NHV2_2', 'NHV1_NHV2_1'] == pytest.approx(1.0, abs=1e-6)
+    assert lodf.loc['NHV1_NHV2_1', 'NHV1_NHV2_2'] == pytest.approx(1.0, abs=1e-6)
+    # and does not change the flow of the transformer in antenna
+    assert lodf.loc['NGEN_NHV1', 'NHV1_NHV2_1'] == pytest.approx(0.0, abs=1e-6)
+    # an outaged branch loses all of its flow
+    assert lodf.loc['NHV1_NHV2_1', 'NHV1_NHV2_1'] == -1.0
+    # the outage of the transformer breaks the network connectivity: LODF factors are undefined
+    assert pd.isna(lodf.loc['NHV1_NHV2_1', 'NGEN_NHV1'])
+
