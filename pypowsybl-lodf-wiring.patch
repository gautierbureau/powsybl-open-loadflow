From ae0d5266bb90f39509e9267fde2964c30c09e089 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 8 Jul 2026 07:38:46 +0000
Subject: [PATCH 3/5] Chunk LODF outaged branches to support full N-1 of large
 networks

A single native LODF call returns a dense buffer capped at ~268M elements,
so a full N-1 of a large network (monitored x outaged over the limit)
could not be returned. compute_lodf_matrix now automatically processes the
outaged branches in column chunks that each stay within the limit, and
concatenates them, with an optional max_columns_per_chunk override.
Verified that chunked results are identical to a single call.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01U4QG5WNJWFjqfFxQHvDcga
---
 pypowsybl/sensitivity/impl/util.py | 40 ++++++++++++++++++++++++------
 tests/test_sensitivity_analysis.py | 13 ++++++++++
 2 files changed, 45 insertions(+), 8 deletions(-)

diff --git a/pypowsybl/sensitivity/impl/util.py b/pypowsybl/sensitivity/impl/util.py
index fc01d14..cc85f17 100644
--- a/pypowsybl/sensitivity/impl/util.py
+++ b/pypowsybl/sensitivity/impl/util.py
@@ -157,8 +157,12 @@ def get_provider_parameters_names(provider: str = '') -> List[str]:
     return _pypowsybl.get_sensitivity_analysis_provider_parameters_names(provider)
 
 
+# a DenseMatrix is backed by a single double[], so a single native call cannot return more than this many elements
+_MAX_LODF_MATRIX_ELEMENTS = 268_435_455
+
+
 def compute_lodf_matrix(network: Network, monitored_branch_ids: List[str], outaged_branch_ids: List[str],
-                        parameters: Optional[LfParameters] = None) -> pd.DataFrame:
+                        parameters: Optional[LfParameters] = None, max_columns_per_chunk: Optional[int] = None) -> pd.DataFrame:
     """
     Computes the LODF (Line Outage Distribution Factor) matrix of monitored branches for single branch outages,
     using a fast DC computation (a single sparse resolution, whatever the number of branches and outages).
@@ -168,16 +172,36 @@ def compute_lodf_matrix(network: Network, monitored_branch_ids: List[str], outag
     its own outage is -1. The LODF factors of an outage breaking the network connectivity are undefined and
     reported as NaN. The computation is done on the main connected component, at fixed phase tap positions.
 
+    A single native call returns the matrix as a dense buffer, whose number of elements cannot exceed about 268
+    million. When the monitored x outaged product is larger (a full N-1 of a large network), the outaged branches
+    are automatically processed in column chunks and the chunks are concatenated. Note that each chunk reloads and
+    refactorizes the network, so keeping the chunks as large as possible (the default) minimizes the overhead.
+
     Args:
-        network:              the network
-        monitored_branch_ids: ids of the branches on which the flow change is observed
-        outaged_branch_ids:   ids of the branches whose outages are simulated
-        parameters:           the load flow parameters, used to build the DC equation system
+        network:               the network
+        monitored_branch_ids:  ids of the branches on which the flow change is observed
+        outaged_branch_ids:    ids of the branches whose outages are simulated
+        parameters:            the load flow parameters, used to build the DC equation system
+        max_columns_per_chunk: maximum number of outaged branches per native call; defaults to the largest value
+                               keeping each chunk within the dense matrix element limit
 
     Returns:
         the LODF matrix as a dataframe, with one row per monitored branch and one column per outaged branch
     """
     p = parameters if parameters is not None else LfParameters()
-    m = _pypowsybl.compute_lodf_matrix(network._handle, monitored_branch_ids, outaged_branch_ids,
-                                       p._to_c_parameters())  # pylint: disable=protected-access
-    return pd.DataFrame(data=np.array(m, copy=False), index=monitored_branch_ids, columns=outaged_branch_ids)
+    n_monitored = max(1, len(monitored_branch_ids))
+    max_columns = max_columns_per_chunk if max_columns_per_chunk is not None else max(1, _MAX_LODF_MATRIX_ELEMENTS // n_monitored)
+
+    if len(outaged_branch_ids) <= max_columns:
+        m = _pypowsybl.compute_lodf_matrix(network._handle, monitored_branch_ids, outaged_branch_ids,
+                                           p._to_c_parameters())  # pylint: disable=protected-access
+        return pd.DataFrame(data=np.array(m, copy=False), index=monitored_branch_ids, columns=outaged_branch_ids)
+
+    # the full matrix would exceed the dense matrix limit: process the outaged branches in column chunks
+    chunks = []
+    for start in range(0, len(outaged_branch_ids), max_columns):
+        chunk_ids = outaged_branch_ids[start:start + max_columns]
+        m = _pypowsybl.compute_lodf_matrix(network._handle, monitored_branch_ids, chunk_ids,
+                                           p._to_c_parameters())  # pylint: disable=protected-access
+        chunks.append(pd.DataFrame(data=np.array(m, copy=True), index=monitored_branch_ids, columns=chunk_ids))
+    return pd.concat(chunks, axis=1)
