@@ -250,4 +255,40 @@ public final class SensitivityAnalysisCFunctions {
             }
         });
     }
+
+    @CEntryPoint(name = "computeLodfMatrix")
+    public static PyPowsyblApiHeader.MatrixPointer computeLodfMatrix(IsolateThread thread, ObjectHandle networkHandle,
+                                                                     CCharPointerPointer monitoredBranchIdsPtrPtr, int monitoredBranchIdsCount,
+                                                                     CCharPointerPointer outagedBranchIdsPtrPtr, int outagedBranchIdsCount,
+                                                                     LoadFlowParametersPointer loadFlowParametersPtr,
+                                                                     ExceptionHandlerPointer exceptionHandlerPtr) {
+        return doCatch(exceptionHandlerPtr, new PointerProvider<>() {
+            @Override
+            public PyPowsyblApiHeader.MatrixPointer get() {
+                Network network = ObjectHandles.getGlobal().get(networkHandle);
+                List<String> monitoredBranchIds = toStringList(monitoredBranchIdsPtrPtr, monitoredBranchIdsCount);
+                List<String> outagedBranchIds = toStringList(outagedBranchIdsPtrPtr, outagedBranchIdsCount);
+                LoadFlowParameters parameters = LoadFlowCUtils.createLoadFlowParameters(loadFlowParametersPtr,
+                        LoadFlowCUtils.getLoadFlowProvider(PyPowsyblConfiguration.getDefaultLoadFlowProvider()));
+                DenseMatrix lodfMatrix = LodfComputer.computeLodfMatrix(network, monitoredBranchIds, outagedBranchIds, parameters);
+                return denseMatrixToMatrixPointer(lodfMatrix);
+            }
+        });
+    }
+
+    private static PyPowsyblApiHeader.MatrixPointer denseMatrixToMatrixPointer(DenseMatrix denseMatrix) {
+        int rowCount = denseMatrix.getRowCount();
+        int columnCount = denseMatrix.getColumnCount();
+        CDoublePointer valuePtr = UnmanagedMemory.calloc(rowCount * columnCount * SizeOf.get(CDoublePointer.class));
+        for (int row = 0; row < rowCount; row++) {
+            for (int column = 0; column < columnCount; column++) {
+                valuePtr.addressOf(row * columnCount + column).write(denseMatrix.get(row, column));
+            }
+        }
+        PyPowsyblApiHeader.MatrixPointer matrixPtr = UnmanagedMemory.calloc(SizeOf.get(PyPowsyblApiHeader.MatrixPointer.class));
+        matrixPtr.setRowCount(rowCount);
+        matrixPtr.setColumnCount(columnCount);
+        matrixPtr.setValues(valuePtr);
+        return matrixPtr;
+    }
 }
