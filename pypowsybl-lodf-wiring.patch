+    for max_columns in (1, 3, len(branch_ids)):
+        chunked = pp.sensitivity.compute_lodf_matrix(network, branch_ids, branch_ids, max_columns_per_chunk=max_columns)
+        assert list(chunked.index) == list(reference.index)
+        assert list(chunked.columns) == list(reference.columns)
+        assert np.allclose(chunked.to_numpy(), reference.to_numpy(), equal_nan=True, atol=1e-12)
